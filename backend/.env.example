# Database (Supabase)
DB_HOST=aws-0-xx-xxxx-x.pooler.supabase.com
DB_PORT=5432
DB_USERNAME=postgres.your_project_ref
DB_PASSWORD=your_password
DB_NAME=postgres
DB_SSL=true

# JWT (min 32 chars each)
JWT_SECRET=change_me_generate_with_crypto_32chars
JWT_REFRESH_SECRET=change_me_generate_with_crypto_32chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# App
PORT=3001
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:3000

# Webhook
WEBHOOK_SECRET=change_me

# Redis / BullMQ (Upstash)
REDIS_HOST=your-redis.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=rediss://:your_token@your-redis.upstash.io:6379

# AI
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=4096
ANTHROPIC_API_KEY=

# WhatsApp (Meta Cloud API)
META_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=change_me
META_WABA_ID=

# Email (Resend)
RESEND_API_KEY=

# Supabase Storage
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Upload
UPLOAD_MAX_SIZE_MB=10
UPLOAD_DIR=./uploads
